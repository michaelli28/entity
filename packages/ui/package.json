{
  "name": "@zstar/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/motion.css": "./src/styles/motion.css",
    "./styles/cursor.css": "./src/styles/cursor.css",
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./typographic/*": {
      "types": "./src/typographic/*.tsx",
      "default": "./src/typographic/*.tsx"
    },
    "./surface/*": {
      "types": "./src/surface/*.tsx",
      "default": "./src/surface/*.tsx"
    },
    "./*": {
      "types": "./src/*.tsx",
      "default": "./src/*.tsx"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "motion": "^12.38.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.1.0",
    "motion": "^12.38.0",
    "vaul": "^1.1.2",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^3.0.0"
  }
}
